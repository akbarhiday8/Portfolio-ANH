# Dipakai pada Stage 2 setelah runtime berpindah ke Next.js/Vercel.
# Tidak satu pun nilai di bawah ini mengaktifkan Supabase pada runtime saat ini.

# Alamat final website, misalnya https://portfolio-anh.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Konfigurasi browser/server Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Khusus server dan proses migrasi. Jangan pernah memakai awalan NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Nama bucket ditetapkan oleh migration Stage 1.
SUPABASE_PUBLIC_BUCKET=portfolio-public
SUPABASE_STAGING_BUCKET=portfolio-staging
