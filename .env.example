# Dipakai oleh lapisan client Supabase Stage 2. Runtime aplikasi masih Vinext
# sampai tahap migrasi runtime berikutnya.

# Alamat final website, misalnya https://portfolio-anh.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Konfigurasi browser/server Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Backend konten CMS. Tetap d1 sampai cutover produksi disetujui.
# Nilai valid: d1 | supabase. Jangan memakai awalan NEXT_PUBLIC_.
CMS_DATA_BACKEND=d1

# Nama bucket ditetapkan oleh migration Stage 1.
SUPABASE_PUBLIC_BUCKET=portfolio-public
SUPABASE_STAGING_BUCKET=portfolio-staging
