# Alamat website untuk metadata, sitemap, dan canonical URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Konfigurasi Supabase yang aman dipakai browser dan server. Publishable key
# tetap dibatasi oleh RLS; jangan menambahkan service-role/secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Opsional. Runtime memvalidasi nama bucket final ini.
SUPABASE_PUBLIC_BUCKET=portfolio-public
